{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dikwp.example/schemas/vitavector85/intervention.schema.json",
  "title": "VITAVECTOR-85 Intervention",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {"type": "string", "minLength": 3},
    "owner": {"type": "string"},
    "status": {"enum": ["PROPOSED", "EXECUTED", "STOPPED", "ROLLED_BACK"]},
    "reversible": {"type": "boolean"}
  }
}
